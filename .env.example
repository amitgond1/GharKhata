# Copy this file to .env in the repository root. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27018/gharkhata?replicaSet=rs0
# For Atlas, replace the line above with your real connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gharkhata?retryWrites=true&w=majority

PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
UPLOAD_DIR=uploads
# Optional SMTP; without it links are returned only in development preview.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=GharKhata <hello@example.com>
# Production private S3-compatible storage. Omit bucket for local files.
# S3_BUCKET=gharkhata-private
# S3_REGION=ap-south-1
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# TRUST_PROXY=1
