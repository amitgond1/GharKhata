# Set these in the hosting dashboard, never in frontend code.
NODE_ENV=production
HOST=0.0.0.0
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gharkhata?retryWrites=true&w=majority
# Render supplies RENDER_EXTERNAL_URL automatically. For a custom domain, set:
# APP_ORIGIN=https://your-domain.example
TRUST_PROXY=1
# Mount the persistent disk at /var/data before using this path.
UPLOAD_DIR=/var/data/uploads
# Optional real email service for password resets and invitations:
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=GharKhata <hello@your-domain.example>
